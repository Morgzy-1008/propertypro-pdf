{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hudson Homes OS",
  "version": "2026.1.0",
  "identifier": "au.com.hudsonhomes.os",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hudson Homes Digital Builder OS",
        "width": 1600,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#0f172a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Hudson Homes Australia",
    "shortDescription": "Hudson Homes Estimating, Quoting, Floorplans, Facade Studio & Tender Compare OS",
    "longDescription": "Native Windows Desktop Operating System for Hudson Homes Australia — featuring high-speed local SSD caching, 4K AI Facade Studio, Quoting V2, Floorplan Library, and Forensic Tender Compare.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
